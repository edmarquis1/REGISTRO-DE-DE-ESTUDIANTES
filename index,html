<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Registro de Estudiantes con Supabase</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Supabase JS Client (CDN) -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    body { -webkit-tap-highlight-color: transparent; }
    .toast {
      transition: opacity 0.3s ease, transform 0.3s ease;
    }
  </style>
</head>
<body class="min-h-screen bg-slate-100 text-slate-800 antialiased">

  <!-- ================= ENCABEZADO ================= -->
  <header class="bg-indigo-700 text-white shadow-md sticky top-0 z-20">
    <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
      <div>
        <h1 class="text-lg sm:text-2xl font-bold leading-tight">📚 Registro de Estudiantes</h1>
        <p class="text-indigo-200 text-xs sm:text-sm">Conectado a Supabase (nube)</p>
      </div>
      <span id="db-status" class="text-xs sm:text-sm bg-indigo-800/60 px-3 py-1 rounded-full">
        Conectando…
      </span>
    </div>
  </header>

  <main class="max-w-5xl mx-auto p-4 space-y-6">

    <!-- ============ FORMULARIO ============ -->
    <section class="bg-white rounded-2xl shadow p-4 sm:p-6">
      <h2 class="text-base sm:text-lg font-semibold mb-4 text-slate-700">➕ Nuevo estudiante</h2>
      <form id="form-estudiante" class="grid grid-cols-1 sm:grid-cols-4 gap-3">
        <div class="sm:col-span-2">
          <label class="block text-xs font-medium text-slate-500 mb-1">Nombre</label>
          <input id="input-nombre" type="text" required placeholder="Ej: Ana Gómez"
            class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-500 mb-1">Materia</label>
          <input id="input-materia" type="text" required placeholder="Ej: Bases de Datos"
            class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-500 mb-1">Nota</label>
          <input id="input-nota" type="number" min="0" max="100" required placeholder="0-100"
            class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
        <div class="sm:col-span-4 flex justify-end">
          <button type="submit"
            class="w-full sm:w-auto bg-indigo-600 hover:bg-indigo-700 active:scale-95 transition text-white font-medium px-5 py-2.5 rounded-lg text-sm shadow">
            Guardar estudiante
          </button>
        </div>
      </form>
    </section>

    <!-- ============ TABLA ============ -->
    <section class="bg-white rounded-2xl shadow p-4 sm:p-6">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
        <h2 class="text-base sm:text-lg font-semibold text-slate-700">📋 Estudiantes registrados</h2>
        <span id="contador" class="text-xs text-slate-400">0 registros</span>
      </div>
      <div class="overflow-x-auto rounded-lg border border-slate-200">
        <table class="w-full text-sm text-left">
          <thead class="bg-slate-50 text-slate-500 uppercase text-xs">
            <tr>
              <th class="px-3 py-2">ID</th>
              <th class="px-3 py-2">Nombre</th>
              <th class="px-3 py-2">Materia</th>
              <th class="px-3 py-2">Nota</th>
              <th class="px-3 py-2 text-right">Acciones</th>
            </tr>
          </thead>
          <tbody id="tabla-body" class="divide-y divide-slate-100">
            <tr><td colspan="5" class="px-3 py-6 text-center text-slate-400">Cargando datos…</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- ============ SIN IMPORTAR/EXPORTAR (ya no hace falta) ============ -->
    <section class="bg-white rounded-2xl shadow p-4 sm:p-6">
      <h2 class="text-base sm:text-lg font-semibold mb-1 text-slate-700">☁️ Datos en la nube</h2>
      <p class="text-xs text-slate-400 mb-4">
        Todos los registros se guardan directamente en Supabase. No necesitas exportar/importar archivos.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <button id="btn-recargar"
          class="flex-1 bg-slate-600 hover:bg-slate-700 active:scale-95 transition text-white font-medium px-4 py-2.5 rounded-lg text-sm shadow">
          🔄 Recargar datos
        </button>
      </div>
    </section>

    <p class="text-center text-xs text-slate-400 pb-6">
      Los datos son persistentes en la nube. Accesibles desde cualquier dispositivo.
    </p>
  </main>

  <!-- Toast -->
  <div id="toast" class="toast fixed bottom-4 left-1/2 -translate-x-1/2 opacity-0 pointer-events-none
       bg-slate-900 text-white text-sm px-4 py-2 rounded-full shadow-lg z-50"></div>

  <script>
    // ==============================================================
    //  CONFIGURACIÓN DE SUPABASE (reemplaza con tus credenciales)
    // ==============================================================
    const SUPABASE_URL = 'https://tudominio.supabase.co';
    const SUPABASE_ANON_KEY = 'tu-clave-anon-publica';

    // Inicializar cliente de Supabase
    const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    // ==============================================================
    //  REFERENCIAS DOM
    // ==============================================================
    const dbStatusEl   = document.getElementById('db-status');
    const formEl       = document.getElementById('form-estudiante');
    const tablaBodyEl  = document.getElementById('tabla-body');
    const contadorEl   = document.getElementById('contador');
    const toastEl      = document.getElementById('toast');
    const btnRecargar  = document.getElementById('btn-recargar');

    // Utilidad: toast
    function mostrarToast(mensaje) {
      toastEl.textContent = mensaje;
      toastEl.style.opacity = '1';
      toastEl.style.transform = 'translate(-50%, -8px)';
      clearTimeout(mostrarToast._t);
      mostrarToast._t = setTimeout(() => {
        toastEl.style.opacity = '0';
        toastEl.style.transform = 'translate(-50%, 0)';
      }, 2000);
    }

    // Escapar HTML
    function escapeHtml(texto) {
      const div = document.createElement('div');
      div.textContent = texto;
      return div.innerHTML;
    }

    // Color según nota
    function colorNota(nota) {
      if (nota >= 51) return 'bg-emerald-100 text-emerald-700';
      if (nota >= 30) return 'bg-amber-100 text-amber-700';
      return 'bg-red-100 text-red-700';
    }

    // ==============================================================
    //  FUNCIONES CRUD CON SUPABASE
    // ==============================================================

    // Obtener todos los estudiantes (ordenados por id descendente)
    async function cargarEstudiantes() {
      try {
        const { data, error } = await supabase
          .from('estudiantes')
          .select('*')
          .order('id', { ascending: false });

        if (error) throw error;
        return data || [];
      } catch (err) {
        console.error('Error al cargar:', err);
        mostrarToast('Error al cargar los datos');
        return [];
      }
    }

    // Insertar un nuevo estudiante
    async function guardarEstudiante(nombre, materia, nota) {
      try {
        const { data, error } = await supabase
          .from('estudiantes')
          .insert([{ nombre, materia, nota }])
          .select(); // Devuelve el registro insertado (con el id generado)

        if (error) throw error;
        return data[0]; // el objeto insertado
      } catch (err) {
        console.error('Error al insertar:', err);
        mostrarToast('Error al guardar el estudiante');
        return null;
      }
    }

    // Eliminar un estudiante por id
    async function eliminarEstudiante(id) {
      try {
        const { error } = await supabase
          .from('estudiantes')
          .delete()
          .eq('id', id);

        if (error) throw error;
        return true;
      } catch (err) {
        console.error('Error al eliminar:', err);
        mostrarToast('Error al eliminar el registro');
        return false;
      }
    }

    // ==============================================================
    //  REFRESCAR TABLA (pinta los datos en el HTML)
    // ==============================================================
    async function refrescarTabla() {
      const estudiantes = await cargarEstudiantes();

      tablaBodyEl.innerHTML = '';

      if (estudiantes.length === 0) {
        tablaBodyEl.innerHTML = `
          <tr><td colspan="5" class="px-3 py-6 text-center text-slate-400">
            Aún no hay estudiantes registrados.
          </td></tr>`;
        contadorEl.textContent = '0 registros';
        return;
      }

      contadorEl.textContent = `${estudiantes.length} registro${estudiantes.length === 1 ? '' : 's'}`;

      for (const est of estudiantes) {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-50';
        tr.innerHTML = `
          <td class="px-3 py-2 text-slate-400">${est.id}</td>
          <td class="px-3 py-2 font-medium">${escapeHtml(est.nombre)}</td>
          <td class="px-3 py-2">${escapeHtml(est.materia)}</td>
          <td class="px-3 py-2">
            <span class="px-2 py-0.5 rounded-full text-xs font-semibold ${colorNota(est.nota)}">${est.nota}</span>
          </td>
          <td class="px-3 py-2 text-right">
            <button data-id="${est.id}" class="btn-borrar text-red-500 hover:text-red-700 text-xs font-medium">
              Eliminar
            </button>
          </td>`;
        tablaBodyEl.appendChild(tr);
      }

      // Enlazar eventos a los botones de eliminar
      document.querySelectorAll('.btn-borrar').forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = Number(btn.dataset.id);
          const ok = await eliminarEstudiante(id);
          if (ok) {
            mostrarToast('Registro eliminado');
            refrescarTabla();
          }
        });
      });
    }

    // ==============================================================
    //  EVENTOS DEL FORMULARIO
    // ==============================================================
    formEl.addEventListener('submit', async (e) => {
      e.preventDefault();

      const nombre  = document.getElementById('input-nombre').value.trim();
      const materia = document.getElementById('input-materia').value.trim();
      const nota    = Number(document.getElementById('input-nota').value);

      if (!nombre || !materia || Number.isNaN(nota)) {
        mostrarToast('Completa todos los campos correctamente.');
        return;
      }

      const nuevo = await guardarEstudiante(nombre, materia, nota);
      if (nuevo) {
        formEl.reset();
        document.getElementById('input-nombre').focus();
        mostrarToast('Estudiante guardado ✔');
        refrescarTabla();
      }
    });

    // ==============================================================
    //  BOTÓN RECARGAR
    // ==============================================================
    btnRecargar.addEventListener('click', () => {
      refrescarTabla();
      mostrarToast('Datos recargados');
    });

    // ==============================================================
    //  INICIO
    // ==============================================================
    async function iniciar() {
      dbStatusEl.textContent = 'Conectando a Supabase…';
      try {
        // Hacemos una consulta de prueba para verificar conexión
        const { data, error } = await supabase.from('estudiantes').select('count', { count: 'exact', head: true });
        if (error) throw error;
        dbStatusEl.textContent = '✅ Conectado a Supabase';
        await refrescarTabla();
      } catch (err) {
        console.error(err);
        dbStatusEl.textContent = '⚠️ Error de conexión';
        mostrarToast('No se pudo conectar con Supabase. Revisa tu URL y clave.');
      }
    }

    iniciar();
  </script>
</body>
</html>
